# Copy to .dev.vars (git-ignored) for `npm run dev`. Generate each value with:  openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32+-random-chars
JWT_SECRET=replace-with-another-32+-random-chars

# Quick Connect (shared bot). Optional: without these the dashboard only offers "Custom bot".
SYSTEM_BOT_TOKEN=token-of-the-shared-bot-from-BotFather
TELEGRAM_WEBHOOK_SECRET=random-16+-chars-A-Za-z0-9_-   # e.g. openssl rand -hex 32

# Turnstile bot check on /login (sign-in and sign-up). Optional: enforced only when BOTH keys are set.
# These are Cloudflare's official always-pass TEST keys; real keys: Cloudflare dashboard → Turnstile → Add widget.
#TURNSTILE_SITE_KEY=1x00000000000000000000AA
#TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin panel (/admin). Optional: without ADMIN_EMAIL + ADMIN_PASSWORD_HASH the admin is switched off.
# Make the hash with `npm run admin:hash` (never write the plain password here).
#ADMIN_EMAIL=you@example.com
#ADMIN_PASSWORD_HASH=pbkdf2-sha256$100000$...
#ADMIN_ALLOW_IPS=203.0.113.7,198.51.100.0/24
# Google Search Console (Search tab): the whole service-account JSON on ONE line, plus the property
#GSC_SERVICE_ACCOUNT={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
#GSC_SITE_URL=sc-domain:vaneapp.dev
# Optional VPN / proxy lookup (proxycheck.io)
#PROXYCHECK_KEY=

# Emailed 6-digit codes (sign-up, and sign-in after 3+ days away). Optional: enforced only when BOTH are set.
# Without them sign-up and sign-in work as before. Needs a sender on a domain verified in Resend (resend.com → Domains).
#RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#EMAIL_FROM=Vane <noreply@vaneapp.dev>
