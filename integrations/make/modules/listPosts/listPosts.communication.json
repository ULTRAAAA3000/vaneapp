{
  "url": "/posts",
  "method": "GET",
  "headers": {
    "Authorization": "Bearer {{connection.apiKey}}",
    "Content-Type": "application/json",
    "Accept": "application/json"
  },
  "qs": {
    "view": "{{parameters.view}}"
  },
  "response": {
    "iterate": "{{body.posts}}",
    "limit": "{{parameters.limit}}",
    "output": "{{item}}"
  }
}
