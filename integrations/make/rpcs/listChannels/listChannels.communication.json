{
  "url": "/channels",
  "method": "GET",
  "headers": {
    "Authorization": "Bearer {{connection.apiKey}}",
    "Content-Type": "application/json",
    "Accept": "application/json"
  },
  "response": {
    "iterate": "{{body.channels}}",
    "output": {
      "label": "{{item.name}} ({{item.platform}})",
      "value": "{{item.id}}"
    }
  }
}
