{
  "name": "vaneapp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler pages dev ./public --d1=DB",
    "db:local": "wrangler d1 execute vane-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute vane-db --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy ./public --project-name=vaneapp",
    "typecheck": "tsc --noEmit",
    "cron:dev": "wrangler dev --config worker/wrangler.toml --test-scheduled --local --persist-to .wrangler/state",
    "cron:deploy": "wrangler deploy --config worker/wrangler.toml",
    "cron:secret": "wrangler secret put ENCRYPTION_KEY --config worker/wrangler.toml",
    "cron:logs": "wrangler tail --config worker/wrangler.toml --format pretty",
    "telegram:webhook": "node scripts/telegram-webhook.mjs",
    "cron:secret-bot": "wrangler secret put SYSTEM_BOT_TOKEN --config worker/wrangler.toml",
    "admin:hash": "node scripts/admin-hash.mjs",
    "plan:set": "node scripts/set-plan.mjs",
    "video:set": "node scripts/set-video.mjs",
    "test:api": "node scripts/api-e2e.mjs",
    "test:video": "node scripts/video-e2e.mjs",
    "test:hosts": "node scripts/hosts-e2e.mjs",
    "test:composer": "node scripts/composer-tools-test.mjs",
    "db:migrate:pinterest": "wrangler d1 execute vane-db --remote --file=./migrations/0004-channel-types-pinterest.sql",
    "db:migrate:reddit-facebook": "wrangler d1 execute vane-db --remote --file=./migrations/0003-channel-types-reddit-facebook.sql",
    "db:migrate:networks": "wrangler d1 execute vane-db --remote --file=./migrations/0001-channel-types.sql",
    "check:integrations": "node scripts/check-integrations.mjs",
    "test:unit": "node scripts/run-tests.mjs",
    "build:pages": "node scripts/build-site-pages.mjs && node scripts/stamp-assets.mjs",
    "db:migrate:onboarding": "wrangler d1 execute vane-db --remote --file=./scripts/migrations/007-onboarding.sql",
    "db:migrate:feedback": "wrangler d1 execute vane-db --remote --file=./scripts/migrations/005-feedback.sql",
    "db:migrate:suite": "wrangler d1 execute vane-db --remote --file=./scripts/migrations/004-suite-bundle.sql",
    "db:migrate:video-checks": "wrangler d1 execute vane-db --remote --file=./scripts/migrations/003-video-checks-legacy.sql",
    "db:migrate:integrations": "wrangler d1 execute vane-db --remote --file=./scripts/migrations/002-api-key-integration.sql",
    "test:integrations": "node scripts/integrations-e2e.mjs",
    "build:obsidian": "node scripts/build-obsidian-plugin.mjs",
    "build:assets": "node scripts/stamp-assets.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i scripts/site.tailwind.css -o public/assets/site.css --minify && tailwindcss -c tailwind.app.config.cjs -i scripts/site.tailwind.css -o public/assets/app.css --minify"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
