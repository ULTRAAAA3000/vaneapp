{
  "name": "vaneapp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler pages dev ./public --d1=DB",
    "db:local": "wrangler d1 execute vane-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute vane-db --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy ./public --project-name=vaneapp",
    "typecheck": "tsc --noEmit",
    "cron:dev": "wrangler dev --config worker/wrangler.toml --test-scheduled --local --persist-to .wrangler/state",
    "cron:deploy": "wrangler deploy --config worker/wrangler.toml",
    "cron:secret": "wrangler secret put ENCRYPTION_KEY --config worker/wrangler.toml",
    "cron:logs": "wrangler tail --config worker/wrangler.toml --format pretty",
    "telegram:webhook": "node scripts/telegram-webhook.mjs",
    "cron:secret-bot": "wrangler secret put SYSTEM_BOT_TOKEN --config worker/wrangler.toml",
    "admin:hash": "node scripts/admin-hash.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
